// Schema para ambiente de produção com PostgreSQL e Docker
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GlucoseContext {
  FASTING
  PRE_MEAL
  POST_MEAL
  BEDTIME
  RANDOM
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  name               String
  passwordHash       String
  birthDate          DateTime?
  gender             Gender              @default(OTHER)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  glucoseLogs        GlucoseLog[]
  bloodPressureLogs  BloodPressureLog[]
  weightLogs         WeightLog[]
  heightLogs         HeightLog[]

  @@map("users")
}

model GlucoseLog {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  value      Float
  context    GlucoseContext @default(FASTING)
  notes      String?
  measuredAt DateTime       @default(now())
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([userId, measuredAt(sort: Desc)])
  @@map("glucose_logs")
}

model BloodPressureLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  systolic   Int
  diastolic  Int
  pulse      Int?
  notes      String?
  measuredAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, measuredAt(sort: Desc)])
  @@map("blood_pressure_logs")
}

model WeightLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg   Float
  notes      String?
  measuredAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, measuredAt(sort: Desc)])
  @@map("weight_logs")
}

model HeightLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  heightCm   Float
  notes      String?
  measuredAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, measuredAt(sort: Desc)])
  @@map("height_logs")
}
